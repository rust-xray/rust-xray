{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "udp": true
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "127.0.0.1",
            "port": 24443,
            "users": [
              {
                "id": "__USER_ID__",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "__SNI__",
          "fingerprint": "chrome",
          "publicKey": "__PUBLIC_KEY__",
          "shortId": "__SHORT_ID__",
          "spiderX": "/"
        }
      }
    }
  ]
}
